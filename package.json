{
  "name": "muhebrew-library",
  "version": "2.0.0",
  "description": "Malawi secondary school past papers and books library",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "echo 'Static web build ready'",
    "setup": "node backend/db/setup.js",
    "start": "node server.js",
    "start:auto": "bash startup.sh",
    "update": "git pull origin main && npm install",
    "git:pull": "git fetch origin main && git reset --hard origin/main && npm install",
    "seed": "node backend/db/seed.js",
    "seed:samples": "node backend/db/seed.js --samples",
    "admin": "node backend/db/tools.js",
    "backend": "cd backend && npm start"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^1.61.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.0",
    "pdfjs-dist": "^3.11.174"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "better-sqlite3": "^11.8.1"
  }
}
