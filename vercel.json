{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/admin(\\.html)?",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/auth(\\.html)?",
      "dest": "/frontend/auth.html"
    },
    {
      "src": "/teacher(\\.html)?",
      "dest": "/frontend/teacher.html"
    },
    {
      "src": "/muhebrew-backend-updated.zip",
      "dest": "/api/index.js"
    },
    {
      "src": "/download-zip",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
